---
import "../styles/global.css";
import { hasContact } from "../site";

interface Props {
  title: string;
  description?: string;
  image?: string; // og/twitter image, absolute path or URL
  ogType?: "website" | "article";
  publishedTime?: Date;
}
const {
  title,
  description = "Crane-game prize weight-distribution measurements, translated into English and Simplified Chinese.",
  image = "/og.png",
  ogType = "website",
  publishedTime,
} = Astro.props;

const site = Astro.site ?? new URL("https://centre-pullz.omochanochachacha11.workers.dev/");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const isDefaultImage = image === "/og.png";
const year = new Date().getFullYear();

const siteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Centre Pullz",
  alternateName: "Centre Pullz 重心データベース",
  url: new URL("/", site).toString(),
  description:
    "Crane-game prize center-of-gravity measurements from Merry☆An, translated into English and Simplified Chinese.",
  inLanguage: ["en", "zh-CN"],
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: new URL("/database/?q={search_term_string}", site).toString(),
    },
    "query-input": "required name=search_term_string",
  },
};

const nav = [
  { href: "/database/", label: "Database", zh: "数据库" },
  { href: "/guide/", label: "Guide", zh: "攻略入门" },
  { href: "/about/", label: "About", zh: "关于" },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f2942" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Fonts: preconnect + non-blocking link beats @import inside the stylesheet,
         which delays first paint until the CSS request chain resolves. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Centre Pullz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href="/" class="brand" aria-label="Centre Pullz — home">
          <span class="brand__mark mono" aria-hidden="true">⌖</span>
          <span class="brand__name display">CENTRE PULLZ</span>
          <span class="brand__tag mono">重心データベース</span>
        </a>
        <nav class="site-nav mono" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <p class="site-footer__brand display">CENTRE PULLZ</p>
          <p>
            A free, bilingual database of crane-game prize centre-of-gravity
            measurements — so you know where the weight sits before you spend a coin.
          </p>
          <p class="footer-zh zh">抓娃娃奖品重心实测数据库，中英双语，免费查询。</p>
          {hasContact && (
            <p class="site-footer__contact">
              Corrections, takedown requests or questions —{" "}
              <a href="/contact/">get in touch</a>
            </p>
          )}
        </div>
        <nav class="site-footer__links mono" aria-label="Footer">
          <a href="/database/">Database</a>
          <a href="/guide/">Guide</a>
          <a href="/about/">About</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          {hasContact && <a href="/contact/">Contact</a>}
        </nav>
      </div>
      <div class="wrap site-footer__fine mono">
        <p>
          Measurements compiled from
          <a href="https://x.com/6eS8Jm4YNJpPA2D" target="_blank" rel="noopener">Merry☆An (@6eS8Jm4YNJpPA2D)</a>
          on X, used with credit. Prize photos are the manufacturers' official product
          images, hot-linked from their own sites — never re-hosted here.
        </p>
        <p>
          © {year} Centre Pullz · Not affiliated with, endorsed by, or sponsored by any
          manufacturer, arcade operator, or rights holder named on this site.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 10px 16px;
    z-index: 100;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .skip-link:focus {
    left: 0;
  }
  .site-header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(15, 41, 66, 0.92);
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .brand__mark {
    color: var(--accent);
    font-size: 20px;
  }
  .brand__tag {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .site-nav {
    display: flex;
    gap: 6px;
    font-size: 13px;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--text-muted);
    padding: 7px 12px;
    border-radius: var(--radius);
    border: 1px solid transparent;
  }
  .site-nav a:hover {
    color: var(--accent);
    border-color: var(--border);
  }
  .site-nav a[aria-current="page"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 72px;
    padding: 32px 0 56px;
    color: var(--text-muted);
    font-size: 13px;
  }
  .site-footer a {
    color: var(--accent);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: start;
  }
  .site-footer__grid > div > p {
    margin: 0 0 8px;
    max-width: 52ch;
  }
  .site-footer__brand {
    font-size: 15px;
    letter-spacing: 0.06em;
    color: #fff;
  }
  .footer-zh {
    color: var(--text);
  }
  .site-footer__grid > div > p.site-footer__contact {
    margin-top: 12px;
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: right;
    font-size: 12px;
  }
  .site-footer__fine {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 11px;
    line-height: 1.6;
  }
  .site-footer__fine p {
    margin: 0 0 6px;
  }
  @media (max-width: 640px) {
    .brand__tag {
      display: none;
    }
    .site-header__inner {
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
    .site-footer__links {
      text-align: left;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 14px;
    }
  }
</style>
