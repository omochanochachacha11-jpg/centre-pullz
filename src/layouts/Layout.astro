---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Crane-game prize weight-distribution measurements, translated." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href="/" class="brand">
          <span class="brand__mark mono">⌖</span>
          <span class="display">CENTER PULL</span>
          <span class="brand__tag mono">重心データベース</span>
        </a>
        <nav class="site-nav mono">
          <a href="https://x.com/6eS8Jm4YNJpPA2D" target="_blank" rel="noopener">
            <span class="en">Measured by Merry☆An</span><span class="zh-inline">实测数据</span>
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap mono">
        <p>
          Center-of-gravity measurements compiled from
          <a href="https://x.com/6eS8Jm4YNJpPA2D" target="_blank" rel="noopener">Merry☆An (@6eS8Jm4YNJpPA2D)</a>
          on X. Prize photos are the manufacturers' official product images, linked directly — not re-uploaded.
        </p>
        <p class="footer-zh">
          重心实测数据整理自 X 用户
          <a href="https://x.com/6eS8Jm4YNJpPA2D" target="_blank" rel="noopener">Merry☆An（@6eS8Jm4YNJpPA2D）</a>。
          奖品图片为厂商官方商品图，直接外链，未经二次上传。
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .brand__mark {
    color: var(--accent);
    font-size: 20px;
  }
  .brand__tag {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .site-nav {
    display: flex;
    gap: 24px;
    font-size: 13px;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.2;
    text-align: right;
  }
  .site-nav a:hover {
    color: var(--accent);
  }
  .site-nav .zh-inline {
    font-size: 10px;
    color: var(--text-muted);
  }
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 64px;
    padding: 24px 0 48px;
    color: var(--text-muted);
    font-size: 12px;
  }
  .site-footer a {
    color: var(--accent);
  }
  .footer-zh {
    color: var(--text);
    margin-top: 6px;
  }
  @media (max-width: 640px) {
    .brand__tag {
      display: none;
    }
  }
</style>
