---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PrizeCard from "../components/PrizeCard.astro";

const all = await getCollection("prizes");
const sorted = all.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const manufacturers = [...new Set(all.map((e) => e.data.manufacturer))];
---

<Layout title="Center Pull — prize weight-distribution measurements">
  <section class="wrap header">
    <span class="eyebrow">{sorted.length} measured prizes · {manufacturers.length} makers</span>
    <h1>Weight distribution database</h1>
    <p class="lede">
      Center-of-gravity measurements for crane-game prizes, compiled from
      <a href="https://x.com/6eS8Jm4YNJpPA2D" target="_blank" rel="noopener">Merry☆An</a>
      and translated into English and Simplified Chinese.
    </p>
    <p class="lede lede-zh zh">抓娃娃奖品重心实测数据库，整理并翻译自 Merry☆An。</p>
  </section>

  <section class="wrap list">
    {sorted.map((entry) => <PrizeCard entry={entry} />)}
  </section>
</Layout>

<style>
  .header {
    padding: 56px 0 28px;
  }
  .header h1 {
    font-size: clamp(30px, 4vw, 42px);
    margin: 12px 0 10px;
  }
  .lede {
    max-width: 60ch;
    color: var(--text-muted);
    font-size: 16px;
    margin: 0;
  }
  .lede a {
    color: var(--accent);
  }
  .lede-zh {
    margin-top: 10px;
    font-size: 15px;
  }
  .list {
    display: grid;
    gap: 14px;
    padding-bottom: 64px;
  }
</style>
