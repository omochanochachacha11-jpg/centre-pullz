---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const all = await getCollection("prizes");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"prizes"> };
const d = entry.data;

const date = d.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const specs: { label: string; zh: string; value: string | undefined }[] = [
  { label: "Figure size", zh: "尺寸", value: d.figureSize },
  { label: "Box weight", zh: "箱重", value: d.boxWeight },
  { label: "Box size", zh: "箱体", value: d.boxSize },
].filter((s) => s.value);

const canonical = new URL(`/prizes/${entry.id}`, Astro.site);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: d.titleEn,
  image: [
    new URL(d.imageUrl, Astro.site).toString(),
    ...(d.diagramUrl ? [new URL(d.diagramUrl, Astro.site).toString()] : []),
  ],
  description: d.noteEn,
  brand: { "@type": "Brand", name: d.manufacturer },
  ...(d.series ? { category: d.series } : {}),
  additionalProperty: [
    ...(d.figureSize ? [{ "@type": "PropertyValue", name: "Figure size", value: d.figureSize }] : []),
    ...(d.boxWeight ? [{ "@type": "PropertyValue", name: "Box weight", value: d.boxWeight }] : []),
    ...(d.boxSize ? [{ "@type": "PropertyValue", name: "Box size", value: d.boxSize }] : []),
    ...(d.cog && d.cog.length
      ? [{ "@type": "PropertyValue", name: "Center of gravity", value: d.cog.map((c) => c.en).join("; ") }]
      : []),
  ],
  url: canonical.toString(),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: d.titleEn, item: canonical.toString() },
  ],
};
---

<Layout title={`${d.titleEn} — Center Pull`} description={d.noteEn} image={d.imageUrl}>
  <article class="wrap detail">
    <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <a href="/" class="back mono">← All measurements</a>

    <div class="detail__head">
      <div class="detail__visuals">
        {d.diagramUrl && (
          <figure class="detail__diagram panel">
            <figcaption class="eyebrow">Measured COG · 实测重心</figcaption>
            <img src={d.diagramUrl} alt={`Measured center of gravity — ${d.titleEn}`} loading="lazy" />
            <p class="detail__credit mono">{d.diagramCredit}</p>
          </figure>
        )}
        <figure class="detail__photo panel">
          <img src={d.imageUrl} alt={d.titleEn} loading="lazy" />
          <p class="detail__credit mono">{d.imageCredit}</p>
        </figure>
      </div>
      <div class="detail__info">
        <span class="eyebrow">{d.manufacturer} · {date}</span>
        <h1>{d.titleEn}</h1>
        <p class="detail__title-zh zh">{d.titleZh}</p>
        <p class="detail__title-ja mono">{d.titleJa}</p>
        {d.series && <p class="detail__series mono">Series · {d.series}</p>}
      </div>
    </div>

    {specs.length > 0 && (
      <div class="detail__specs">
        {specs.map((s) => (
          <div class="detail__spec panel">
            <span class="detail__spec-label mono">{s.label} · {s.zh}</span>
            <span class="detail__spec-value display">{s.value}</span>
          </div>
        ))}
      </div>
    )}

    {d.cog && d.cog.length > 0 && (
      <section class="detail__cog panel">
        <span class="eyebrow">Center of gravity · 重心位置</span>
        <ul class="detail__cog-list">
          {d.cog.map((c) => (
            <li>
              <span class="detail__cog-en">{c.en}</span>
              <span class="detail__cog-zh zh">{c.zh}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="detail__note panel">
      <span class="eyebrow">Note · 备注</span>
      <p class="detail__note-en">{d.noteEn}</p>
      <p class="detail__note-zh zh">{d.noteZh}</p>
    </section>

    <section class="detail__tips panel">
      <span class="eyebrow">Hashi-watashi tips · 桥渡式攻略提示</span>
      <p class="detail__tips-en">{d.tipEn}</p>
      <p class="detail__tips-zh zh">{d.tipZh}</p>
      <p class="detail__tips-ai mono">AI suggestion · 仅供参考</p>
    </section>

    <a class="btn btn--ghost" href={d.sourceUrl} target="_blank" rel="noopener">
      View original post on X ↗
    </a>
  </article>
</Layout>

<style>
  .detail {
    padding: 32px 0 80px;
  }
  .back {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 12px;
  }
  .detail__head {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 32px;
    margin: 20px 0 28px;
    align-items: start;
  }
  .detail__visuals {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .detail__diagram,
  .detail__photo {
    margin: 0;
    padding: 10px;
    text-align: center;
  }
  .detail__diagram figcaption {
    text-align: left;
    margin: 2px 2px 10px;
  }
  .detail__diagram img,
  .detail__photo img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
  }
  .detail__credit {
    font-size: 10px;
    color: var(--text-muted);
    margin: 10px 0 0;
  }
  .detail__info h1 {
    font-size: clamp(26px, 3.6vw, 38px);
    margin: 10px 0 6px;
  }
  .detail__title-zh {
    font-size: 18px;
    margin: 6px 0 4px;
  }
  .detail__title-ja {
    color: var(--text-muted);
    font-size: 13px;
    margin: 0;
  }
  .detail__series {
    color: var(--text-muted);
    font-size: 12px;
    margin: 14px 0 0;
  }
  .detail__specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin: 0 0 24px;
  }
  .detail__spec {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .detail__spec-label {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }
  .detail__spec-value {
    font-size: 22px;
    color: #fff;
  }
  .detail__cog {
    margin: 0 0 20px;
    padding: 20px;
  }
  .detail__cog-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .detail__cog-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .detail__cog-en {
    font-size: 16px;
  }
  .detail__cog-zh {
    font-size: 14px;
  }
  .detail__note {
    margin: 0 0 20px;
    padding: 20px;
  }
  .detail__note-en {
    font-size: 16px;
    margin: 12px 0 0;
  }
  .detail__note-zh {
    font-size: 15px;
    margin: 10px 0 0;
  }
  .detail__tips {
    margin: 0 0 24px;
    padding: 20px;
    border-left: 3px solid var(--accent);
  }
  .detail__tips-en {
    font-size: 16px;
    line-height: 1.7;
    margin: 12px 0 0;
  }
  .detail__tips-zh {
    font-size: 15px;
    line-height: 1.7;
    margin: 10px 0 0;
  }
  .detail__tips-ai {
    font-size: 10px;
    color: var(--text-muted);
    margin: 14px 0 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 720px) {
    .detail__head {
      grid-template-columns: 1fr;
    }
    .detail__visuals {
      max-width: 380px;
    }
  }
</style>
