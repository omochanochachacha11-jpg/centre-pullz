---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PrizeRow from "../components/PrizeRow.astro";

// ponytail: every row is server-rendered so crawlers (and JS-less clients) get the
// whole database, and filtering is pure client-side DOM toggling. Fine to a few
// hundred entries; past ~500 rows, paginate or move the index to a fetched JSON file.
const all = await getCollection("prizes");
const sorted = all.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const makers = [...new Set(all.map((e) => e.data.manufacturer))].sort();
const series = [...new Set(all.map((e) => e.data.series).filter(Boolean))];

const description = `Search ${sorted.length} crane-game prize centre-of-gravity measurements by name, series, or manufacturer. Box weight, box size and measured balance point for every entry.`;
---

<Layout title={`Database — search ${sorted.length} prize measurements · Centre Pullz`} description={description}>
  <section class="wrap db-head">
    <span class="eyebrow">Database · 数据库</span>
    <h1>Search the measurements</h1>
    <p class="lede">
      Every prize Merry☆An has measured, searchable by prize name, series or
      manufacturer — in English, Chinese or the original Japanese.
    </p>
  </section>

  <section class="wrap db-controls" aria-label="Search and filter">
    <div class="db-controls__search">
      <label class="visually-hidden" for="q">Search prizes</label>
      <input
        id="q"
        class="field"
        type="search"
        placeholder="Search — e.g. Frieren, Grandista, 初音ミク, 芙莉莲…"
        autocomplete="off"
      />
    </div>
    <div class="db-controls__selects">
      <label class="visually-hidden" for="maker">Filter by manufacturer</label>
      <select id="maker" class="field field--select">
        <option value="">All manufacturers</option>
        {makers.map((m) => <option value={m}>{m}</option>)}
      </select>
      <label class="visually-hidden" for="sort">Sort order</label>
      <select id="sort" class="field field--select">
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="heaviest">Heaviest box</option>
        <option value="lightest">Lightest box</option>
        <option value="az">Name A–Z</option>
      </select>
    </div>
    <p class="db-count mono" id="count" role="status" aria-live="polite">
      {sorted.length} of {sorted.length} entries
    </p>
  </section>

  <section class="wrap">
    <ul class="db-list" id="list">
      {sorted.map((entry) => <PrizeRow entry={entry} />)}
    </ul>
    <p class="db-empty" id="empty" hidden>
      No prizes match that search. Try a shorter term, a series name, or
      <button type="button" class="linkish" id="reset">clear the filters</button>.
    </p>
  </section>

  <section class="wrap db-facts">
    <p class="mono">
      {sorted.length} entries · {makers.length} manufacturers · {series.length} series
    </p>
  </section>
</Layout>

<script src="/database-search.js" defer is:inline></script>

<style>
  .db-head {
    padding: 48px 0 20px;
  }
  .db-head h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 12px 0 10px;
  }
  .lede {
    max-width: 60ch;
    color: var(--text-muted);
    font-size: 16px;
    margin: 0;
  }
  .db-controls {
    display: grid;
    gap: 12px;
    padding-bottom: 20px;
  }
  .db-controls__search {
    display: block;
  }
  .db-controls__selects {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .field--select {
    width: auto;
    min-width: 190px;
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 10px 12px;
  }
  .db-count {
    font-size: 12px;
    color: var(--text-muted);
    margin: 2px 0 0;
    letter-spacing: 0.04em;
  }
  .db-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
  }
  .db-empty {
    padding: 48px 0;
    color: var(--text-muted);
    text-align: center;
  }
  .linkish {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--accent);
    cursor: pointer;
    text-decoration: underline;
  }
  .db-facts {
    padding: 28px 0 64px;
    color: var(--text-muted);
    font-size: 12px;
    border-top: 1px solid var(--border);
    margin-top: 28px;
  }
</style>
