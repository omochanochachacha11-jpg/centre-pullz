---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Not found · Center Pull">
  <section class="wrap nf">
    <span class="eyebrow">404</span>
    <h1>Nothing weighs anything here.</h1>
    <p class="nf__zh zh">这里没有收录任何奖品数据。</p>
    <a class="btn btn--ghost" href="/">← Back to the database</a>
  </section>
</Layout>

<style>
  .nf {
    padding: 96px 0;
    max-width: 640px;
  }
  .nf h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 12px 0 10px;
  }
  .nf__zh {
    margin: 0 0 28px;
  }
</style>
