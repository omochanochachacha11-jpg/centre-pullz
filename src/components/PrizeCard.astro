---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"prizes">;
}

const { entry } = Astro.props;
const d = entry.data;

const date = d.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const specs: { label: string; zh: string; value: string | undefined }[] = [
  { label: "Figure size", zh: "尺寸", value: d.figureSize },
  { label: "Box weight", zh: "箱重", value: d.boxWeight },
  { label: "Box size", zh: "箱体", value: d.boxSize },
].filter((s) => s.value);
---

<a href={`/prizes/${entry.id}`} class="card panel">
  <div class="card__photo">
    <img src={d.imageUrl} alt={d.titleEn} loading="lazy" />
  </div>

  <div class="card__body">
    <span class="eyebrow">{d.manufacturer} · {date}</span>
    <h3 class="card__title">{d.titleEn}</h3>
    <p class="card__title-zh zh">{d.titleZh}</p>
    <p class="card__title-ja mono">{d.titleJa}</p>

    {specs.length > 0 && (
      <div class="card__specs mono">
        {specs.map((s) => (
          <span class="spec"><b>{s.label}</b> {s.value}</span>
        ))}
      </div>
    )}

    {d.cog && d.cog.length > 0 && (
      <div class="card__cog">
        {d.cog.map((c) => (
          <span class="tag">{c.en}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: 20px;
    padding: 18px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card__photo {
    flex: none;
    width: 140px;
    height: 140px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .card__title {
    font-size: 19px;
    margin: 2px 0 0;
  }
  .card__title-zh {
    font-size: 15px;
    margin: 2px 0 0;
  }
  .card__title-ja {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0 0 6px;
  }
  .card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 12px;
    color: var(--text);
    margin: 4px 0 0;
  }
  .card__specs .spec b {
    color: var(--text-muted);
    font-weight: 500;
    margin-right: 4px;
  }
  .card__cog {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  @media (max-width: 560px) {
    .card {
      flex-direction: column;
    }
    .card__photo {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
    }
  }
</style>
