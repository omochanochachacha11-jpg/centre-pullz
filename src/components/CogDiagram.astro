---
interface Props {
  x: number; // 0-100
  y: number; // 0-100
  zoneRadius?: number; // 2-40
  pushDirection?: "up" | "down" | "left" | "right";
  confidence?: "low" | "medium" | "high";
  size?: number; // px, square
}

const {
  x,
  y,
  zoneRadius = 10,
  pushDirection,
  confidence = "medium",
  size = 160,
} = Astro.props;

const arrow: Record<string, { dx: number; dy: number; rotate: number }> = {
  up: { dx: 0, dy: -1, rotate: 0 },
  down: { dx: 0, dy: 1, rotate: 180 },
  left: { dx: -1, dy: 0, rotate: -90 },
  right: { dx: 1, dy: 0, rotate: 90 },
};
const a = pushDirection ? arrow[pushDirection] : null;
const confidenceColor =
  confidence === "high" ? "var(--accent-alt)" : confidence === "low" ? "var(--text-muted)" : "var(--accent)";
---

<svg
  viewBox="0 0 100 100"
  width={size}
  height={size}
  role="img"
  aria-label={`Center of gravity marked at ${x}%, ${y}% of the box, confidence ${confidence}`}
  class="cog-diagram"
>
  <!-- box outline -->
  <rect x="6" y="6" width="88" height="88" rx="2" fill="none" stroke="var(--border)" stroke-width="1.5" />
  <!-- fine grid inside the box, like drafting paper -->
  {Array.from({ length: 7 }).map((_, i) => (
    <line
      x1={6 + ((i + 1) * 88) / 8}
      y1="6"
      x2={6 + ((i + 1) * 88) / 8}
      y2="94"
      stroke="var(--grid-line)"
      stroke-width="1"
    />
  ))}
  {Array.from({ length: 7 }).map((_, i) => (
    <line
      x1="6"
      y1={6 + ((i + 1) * 88) / 8}
      x2="94"
      y2={6 + ((i + 1) * 88) / 8}
      stroke="var(--grid-line)"
      stroke-width="1"
    />
  ))}

  <!-- confidence zone -->
  <circle cx={x} cy={y} r={zoneRadius / 2.2} fill={confidenceColor} opacity="0.18" />

  <!-- crosshair -->
  <g stroke={confidenceColor} stroke-width="1.6">
    <line x1={x - 6} y1={y} x2={x + 6} y2={y} />
    <line x1={x} y1={y - 6} x2={x} y2={y + 6} />
  </g>
  <circle cx={x} cy={y} r="2.2" fill={confidenceColor} />

  {a && (
    <g transform={`translate(${x + a.dx * 14}, ${y + a.dy * 14}) rotate(${a.rotate})`}>
      <path d="M0,-6 L4,3 L-4,3 Z" fill={confidenceColor} />
    </g>
  )}
</svg>

<style>
  .cog-diagram {
    display: block;
  }
</style>
